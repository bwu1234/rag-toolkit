{
  "description": "Lint Python files edited by Codex, matching the Claude Code hook.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/lint-python.py\"",
            "timeout": 60,
            "statusMessage": "Linting edited Python"
          }
        ]
      }
    ]
  }
}
