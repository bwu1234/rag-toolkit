__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/

# Fetched corpora — the manifest and the fetch script are committed, the
# documents they reproduce are not (keeps the repo small, and avoids
# redistributing third-party content).
data/corpora/*/documents/
# The raw source a fetcher caches so re-rendering needs no new requests.
data/corpora/*/raw/
# ...except `baseline`, the small hand-written sample corpus: it's committed
# content, not fetched, so it's exempt from the rule above.
!data/corpora/baseline/documents/

# Local generated index — rebuildable, not source.
data/index/*
!data/index/.gitkeep
# The alternate index built for the contextual-chunking comparison
# (data/eval/config_contextual.yaml points its index_dir here). Same category:
# 79MB of Chroma sqlite and binary blobs, rebuildable from the corpus.
data/index_ctx/
# Per-embedder indexes for the chunking plan's Phase 1b size comparison
# (data/eval/config_embedder_*.yaml).
data/index_emb-*/
# The header-on index for the chunking plan's Phase 2 (data/eval/config_header.yaml).
data/index_header/
# The header-free index rag/config/vanilla.yaml reads, so its floor stays plain RAG.
data/index_vanilla/

# Per-turn logs (Milestone 12) -- local usage data, not source.
data/logs/

.env
draft/
pytest-cache-files-gvcbngex/
# Per-sample eval checkpoints (rag/eval/checkpoint.py); deleted once a set finishes.
data/eval/results/.partial/

# BEIR queries and qrels (scripts/fetch_beir.py) sit outside documents/ so they
# never reach an index; fetched like the passages, never committed.
data/corpora/beir-*/source/
# Eval sets converted from those qrels (scripts/beir_to_eval_set.py): regenerated
# from the pinned archive, and the labels are third-party data.
data/eval/beir_*.json
# The benchmark index rag/config/beir.yaml reads (public benchmarks plan).
data/index_beir/
